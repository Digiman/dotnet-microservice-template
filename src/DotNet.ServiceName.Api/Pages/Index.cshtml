@page
@using DotNet.ServiceName.Common.Configuration
@model IndexModel
@{
    var selectedTheme = Model.Home.DefaultTheme.ToString().ToLowerInvariant();
}
<!DOCTYPE html>
<html lang="en" data-theme-default="@selectedTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Home.Title</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @* applied before the first paint, so the page never flashes in the wrong theme *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
    <header class="topbar">
        <div class="topbar__brand">
            <img class="topbar__mark" src="~/images/service-mark.svg" alt="" />
            <h1 class="topbar__title">@Model.Home.Title</h1>
        </div>

        <div class="topbar__actions">
            @if (Model.Home.ShowEnvironment)
            {
                <p class="topbar__badge">@Model.Home.Environment</p>
            }

            <fieldset class="themes">
                <legend class="themes__legend">Theme</legend>
                @foreach (var theme in new[] { HomePageTheme.System, HomePageTheme.Light, HomePageTheme.Dark })
                {
                    var value = theme.ToString().ToLowerInvariant();
                    var isChecked = theme == Model.Home.DefaultTheme;
                    <label class="themes__option">
                        <input type="radio" name="home-theme" value="@value" checked="@isChecked" />
                        <span>@theme</span>
                    </label>
                }
            </fieldset>
        </div>
    </header>

    <main class="home">
        @if (!string.IsNullOrWhiteSpace(Model.Home.Description))
        {
            <p class="home__lead">@Model.Home.Description</p>
        }

        @if (Model.Home.Links.Count > 0)
        {
            <ul class="home__links">
                @foreach (var link in Model.Home.Links)
                {
                    <li>
                        <a class="home__link" href="@link.Url" target="@(link.OpenInNewTab ? "_blank" : null)"
                           rel="@(link.OpenInNewTab ? "noopener noreferrer" : null)">
                            @if (!string.IsNullOrWhiteSpace(link.Icon))
                            {
                                <img class="home__link-icon" src="@link.Icon" alt="" />
                            }
                            <span class="home__link-title">@link.Title</span>
                            @if (!string.IsNullOrWhiteSpace(link.Description))
                            {
                                <span class="home__link-description">@link.Description</span>
                            }
                            @if (link.OpenInNewTab)
                            {
                                <span class="visually-hidden">Opens in a new tab</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="home__note">This service does not expose any additional endpoints.</p>
        }

        @if (Model.Home.DocumentationDisabled)
        {
            <p class="home__note">API documentation is not available in this environment.</p>
        }
    </main>
</body>
</html>
